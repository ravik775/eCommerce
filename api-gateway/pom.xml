<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.bgm</groupId>
        <artifactId>eCommerce</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>api-gateway</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>api-gateway</name>
    <description>api-gateway</description>
    <!--properties>
        <java.version>17</java.version>
        <spring-cloud.version>2024.0.1</spring-cloud.version>
    </properties-->
    <dependencies>
        <!-- ADR-0023: shared header/MDC-key constants (the reactive filter
             itself lives here in api-gateway — GatewayConfig.java — since
             common-lib's filter is Servlet-based and the gateway is
             WebFlux). -->
        <dependency>
            <groupId>org.bgm</groupId>
            <artifactId>common-lib</artifactId>
            <!-- Not ${project.version}: api-gateway declares its own
                 0.0.1-SNAPSHOT version, distinct from common-lib's
                 (inherited from the root aggregator, 1.0-SNAPSHOT). -->
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!-- ADR-0002: transitively pulling in java-spiffe-provider (via
             common-lib) brings the real io.grpc:grpc-api onto this
             module's classpath, which satisfies Spring Cloud Gateway's
             own (coarser) @ConditionalOnClass guard for its optional
             gRPC-JSON-transcoding filter (GrpcSslConfigurer) — but that
             bean's actual construction needs io.grpc.netty.NettyChannelBuilder
             from the real (unshaded) grpc-netty artifact, which isn't
             otherwise present (only java-spiffe-provider's internal
             grpc-netty-shaded is). Without this, the gateway fails to
             start with NoClassDefFoundError on every boot — found live
             on first mTLS-enabled deploy. This module doesn't use gRPC
             JSON transcoding itself; the dependency exists purely to let
             that upstream bean construct successfully. -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty</artifactId>
            <version>1.80.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <!--dependency->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency-->
        <!-- https://mvnrepository.com/artifact/org.springframework.cloud/spring-cloud-starter-gateway -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway</artifactId>
            <version>4.2.1</version>
        </dependency>
        <!-- actuator + micrometer-registry-prometheus now come from
             common-lib (Phase 7) — was previously declared here directly
             plus a malformed, effectively-disabled commented-out
             prometheus dependency block (missing the closing dash on its
             opening comment tag, so it was never actually active).
             Removed rather than fixed in place, since common-lib already
             covers it for every service. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-reactor-resilience4j</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
        </dependency>
        <!-- ADR-0005 (gateway terminates the browser-facing OIDC login) /
             ADR-0017 (PKCE): reactive OAuth2 client. Also brings Spring
             Cloud Gateway's TokenRelay filter factory into play (built
             into spring-cloud-starter-gateway once this is on the
             classpath), which relays the resulting access token to
             downstream services as `Authorization: Bearer` — the BFF
             pattern this project's ADR-0005 describes. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
    </dependencies>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- ADR-0011: opt into the shared release-zip assembly (config in root pluginManagement). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>