<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.bgm</groupId>
        <artifactId>eCommerce</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>common-lib</artifactId>

    <!-- Was overriding compiler source/target to 25, inconsistent with the
         rest of the reactor's Java 21 target (root pom.xml) — removed so
         this module inherits the same target as every other module. -->

    <dependencies>
        <!-- ADR-0015 (doc/adr/ADR-0015-kafka-schema-json-documented.md):
             Kafka events stay plain JSON with no schema registry, but are
             validated against a checked-in JSON Schema at publish and
             consume time — this is the concrete enforcement mechanism for
             that decision, shared by every producer/consumer via common-lib. -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>1.5.6</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- ADR-0023 (doc/adr/ADR-0023-correlation-trace-id.md): the shared
             correlation/trace-ID filter, auto-configured into every
             Servlet-based service that depends on common-lib. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- ADR-0025 (doc/adr/ADR-0025-jwt-rbac-method-security.md): shared
             Keycloak realm_access.roles -> ROLE_* GrantedAuthority mapping,
             consumed by every servlet-based (non-gateway) service as an
             OAuth2 resource server. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ADR-0002: SPIFFE/SPIRE zero-trust mTLS (inbound Tomcat,
             outbound RestTemplate). SpiffeMtlsAutoConfiguration builds
             its X509Source bean unconditionally once
             spiffe.mtls.enabled=true (every servlet-based service in
             K8s), and Spring's own ConditionalOnMissingBean type
             deduction needs io.spiffe.workloadapi.X509Source resolvable
             at class-load time regardless of which specific inbound/
             outbound auto-config ends up active — an `optional` (or
             `provided`) dependency here does NOT propagate to modules
             that depend on common-lib, so every consumer crashed at
             startup with ClassNotFoundException: X509Source, found live
             on first deploy. NOT optional, for that reason. -->
        <dependency>
            <groupId>io.spiffe</groupId>
            <artifactId>java-spiffe-core</artifactId>
            <version>0.8.17</version>
        </dependency>
        <dependency>
            <groupId>io.spiffe</groupId>
            <artifactId>java-spiffe-provider</artifactId>
            <version>0.8.17</version>
        </dependency>
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
            <version>5.4.2</version>
        </dependency>
        <!-- provided, not compile scope: common-lib needs Connector/
             SSLHostConfig on ITS OWN compile classpath to build
             SpiffeInboundMtlsAutoConfiguration at all (a module's javac
             run only sees its own declared dependencies, not what a
             downstream consumer happens to bring in — found live: a
             stale target/classes directory masked this locally, but a
             clean Docker build failed with "package
             org.apache.catalina.connector does not exist"). Not
             `compile` scope, since that would force a Tomcat servlet
             container onto every common-lib consumer including the
             reactive-only api-gateway; every actual servlet-based
             service already brings tomcat-embed-core transitively via
             its own spring-boot-starter-web, which is what
             ConditionalOnClass(Connector.class) checks against there. -->
        <dependency>
            <groupId>org.apache.tomcat.embed</groupId>
            <artifactId>tomcat-embed-core</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Gateway's Netty-based outbound mTLS: kept optional since
             only api-gateway (already WebFlux/reactor-netty, with
             spring-cloud-starter-gateway on its classpath regardless) is
             conditional on this; forcing it onto every servlet-based
             service would be the wrong direction. -->
        <dependency>
            <groupId>io.projectreactor.netty</groupId>
            <artifactId>reactor-netty-http</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
