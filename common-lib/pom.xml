<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.bgm</groupId>
        <artifactId>eCommerce</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>common-lib</artifactId>

    <!-- Was overriding compiler source/target to 25, inconsistent with the
         rest of the reactor's Java 21 target (root pom.xml) — removed so
         this module inherits the same target as every other module. -->

    <dependencies>
        <!-- ADR-0015 (doc/adr/ADR-0015-kafka-schema-json-documented.md):
             Kafka events stay plain JSON with no schema registry, but are
             validated against a checked-in JSON Schema at publish and
             consume time — this is the concrete enforcement mechanism for
             that decision, shared by every producer/consumer via common-lib. -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>1.5.6</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- ADR-0023 (doc/adr/ADR-0023-correlation-trace-id.md): the shared
             correlation/trace-ID filter, auto-configured into every
             Servlet-based service that depends on common-lib. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- ADR-0025 (doc/adr/ADR-0025-jwt-rbac-method-security.md): shared
             Keycloak realm_access.roles -> ROLE_* GrantedAuthority mapping,
             consumed by every servlet-based (non-gateway) service as an
             OAuth2 resource server. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Phase 7 (SOC2 observability): shared actuator + Prometheus
             registry so every service exposes /actuator/prometheus
             without each one wiring it individually — mirrors the
             existing common-lib pattern (correlation IDs, security,
             SPIFFE mTLS: shared cross-cutting concerns live here).
             api-gateway already declared its own actuator dependency and
             a broken (malformed, effectively disabled) commented-out
             prometheus registry block — removed from api-gateway/pom.xml
             now that this covers it, avoiding two sources of the same
             dependency. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- ADR-0032: OpenTelemetry distributed tracing. Versions
             inherited from spring-boot-starter-parent's dependency
             management (no explicit <version> needed) — Spring Boot 3.4+
             auto-configures OTLP span export from
             management.otlp.tracing.endpoint once these two are on the
             classpath, no manual exporter bean required. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <!-- Test-only: TestSpanData.builder() for
             ErrorAlwaysSampledSpanExporterTest — same version-management
             chain as opentelemetry-exporter-otlp above (inherited via
             Spring Boot's dependency management), no explicit version. -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk-testing</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ADR-0002 (doc/adr/ADR-0002-zero-trust-spire-app-level.md):
             app-level mTLS via the official SPIFFE Java Workload API
             client — no service mesh. Consumed by both servlet-based
             backend services (inbound Tomcat mTLS) and the reactive
             gateway (outbound Netty mTLS); optional/no-op unless
             spiffe.mtls.enabled=true, so services running outside K8s
             (Docker Compose, no SPIRE agent) are unaffected. -->
        <dependency>
            <groupId>io.spiffe</groupId>
            <artifactId>java-spiffe-provider</artifactId>
            <version>0.8.17</version>
        </dependency>
        <!-- provided: only needed to compile against Tomcat connector
             classes for inbound mTLS wiring; every servlet-based service
             already brings the real dependency transitively via
             spring-boot-starter-web. Not a new runtime dependency for
             those services, and never loads at all for the reactive
             gateway (no Tomcat on its classpath). -->
        <dependency>
            <groupId>org.apache.tomcat.embed</groupId>
            <artifactId>tomcat-embed-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- provided: only needed to compile the outbound RestTemplate
             mTLS wiring; a service must add the real dependency itself
             to actually use it (no current service makes direct
             service-to-service HTTP calls — see
             SpiffeOutboundMtlsAutoConfiguration's Javadoc). -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
            <version>5.4.1</version>
            <scope>provided</scope>
        </dependency>
        <!-- provided: only needed to compile the gateway's reactive
             outbound mTLS wiring (Spring Cloud Gateway's
             HttpClientCustomizer extension point + Netty's own
             SslContext, distinct from javax.net.ssl.SSLContext) —
             api-gateway already brings both transitively via
             spring-cloud-starter-gateway. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-gateway-server</artifactId>
            <version>4.2.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-handler</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor.netty</groupId>
            <artifactId>reactor-netty-http</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Test-only: common-lib itself has no logging implementation
             on its main classpath (slf4j-api only — every consuming
             Spring Boot service brings logback-classic transitively at
             runtime), so AuditLoggerTest needs one to actually capture
             log output via Logback's ListAppender rather than silently
             hitting SLF4J's NOP no-op logger. -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
