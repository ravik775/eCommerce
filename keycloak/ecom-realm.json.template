{
  "realm": "ecom",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      { "name": "CUSTOMER", "description": "Can browse catalog and place/cancel/return orders" },
      { "name": "CATALOG_ADMIN", "description": "Can manage the catalog (any product, not ownership-scoped) — ADR-0033. No inventory or user/role-management privilege" },
      { "name": "INVENTORY_ADMIN", "description": "Can restock inventory (any product) — ADR-0033. No catalog or user/role-management privilege" },
      { "name": "ADMIN", "description": "ADR-0033: can ONLY assign/revoke roles for other users — no operational privilege of its own (not catalog/inventory access)" },
      {
        "name": "SUPER_ADMIN",
        "description": "Union of CATALOG_ADMIN + INVENTORY_ADMIN + ADMIN (ADR-0033) — every capability combined. A real Keycloak composite role, not a manually-duplicated check: a SUPER_ADMIN JWT's realm_access.roles genuinely contains all three underlying roles, so every @PreAuthorize/gateway check only ever needs to name the single specific role it actually means (e.g. hasRole('CATALOG_ADMIN')) — composition happens once, here, at the IAM layer, not re-derived at every enforcement point.",
        "composite": true,
        "composites": { "realm": ["CATALOG_ADMIN", "INVENTORY_ADMIN", "ADMIN"] }
      },
      { "name": "PROVIDER", "description": "Can create/edit/deactivate their own catalog products and add stock for them (Phase 8) — no admin/customer capability implied, not a superset of either" },
      { "name": "CAN_TRACE", "description": "Can enable the Settings > force verbose tracing toggle (ADR-0032)" }
    ]
  },
  "clients": [
    {
      "clientId": "ecommerce-gateway",
      "name": "eCommerce API Gateway (BFF)",
      "description": "Confidential client — the gateway terminates the browser-facing OIDC login (ADR-0005) and relays the resulting access token downstream via Spring Cloud Gateway's TokenRelay filter.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${KEYCLOAK_GATEWAY_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/login/oauth2/code/keycloak"
      ],
      "webOrigins": ["http://localhost:8080"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": ["web-origins", "profile", "roles", "email"],
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "tenant_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "tenant_id",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "ecommerce-ui",
      "name": "eCommerce SPA (Phase 8)",
      "description": "Public client with mandatory PKCE (ADR-0017) — for the future browser SPA if it ever talks to Keycloak directly instead of via the gateway BFF.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "payment-service",
      "name": "payment-service (service account)",
      "description": "client_credentials only — payment-service's OrderServiceClient needs a service-account JWT to call order-service's protected GET /orders/{id} (ADR-0007). See ServiceTokenProvider's Javadoc.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${PAYMENT_SERVICE_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${GOOGLE_CLIENT_ID}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET}",
        "syncMode": "IMPORT",
        "useJwksUrl": "true"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "google-default-customer-role",
      "identityProviderAlias": "google",
      "identityProviderMapper": "oidc-hardcoded-role-idp-mapper",
      "config": { "role": "CUSTOMER" }
    }
  ],
  "users": [
    {
      "username": "customer1",
      "enabled": true,
      "firstName": "Test",
      "lastName": "Customer",
      "email": "customer1@example.test",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "customer1-pass", "temporary": false }],
      "requiredActions": [],
      "realmRoles": ["CUSTOMER"]
    },
    {
      "username": "admin1",
      "enabled": true,
      "firstName": "Test",
      "lastName": "Admin",
      "email": "admin1@example.test",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "admin1-pass", "temporary": false }],
      "requiredActions": [],
      "realmRoles": ["CUSTOMER", "PROVIDER", "CATALOG_ADMIN", "INVENTORY_ADMIN", "ADMIN", "SUPER_ADMIN", "CAN_TRACE"]
    },
    {
      "username": "superadmin1",
      "enabled": true,
      "firstName": "Test",
      "lastName": "SuperAdmin",
      "email": "superadmin1@example.test",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "superadmin1-pass", "temporary": false }],
      "requiredActions": [],
      "realmRoles": ["SUPER_ADMIN", "ADMIN", "CUSTOMER"]
    },
    {
      "username": "provider1",
      "enabled": true,
      "firstName": "Test",
      "lastName": "Provider",
      "email": "provider1@example.test",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "provider1-pass", "temporary": false }],
      "requiredActions": [],
      "realmRoles": ["PROVIDER"]
    }
  ]
}
