# Copy to .env and fill in real values for local development.
# .env is gitignored — never commit real credentials. docker-compose.yml
# and scripts/dev-up.sh both fall back to obvious, clearly-fake
# "changeme-*" defaults if this file doesn't exist, so a first-time
# clone still boots — those defaults are not meant to be used anywhere
# beyond a quick local smoke test.
#
# The equivalent K8s-side credentials live in k8s/base/secrets.yaml as
# Sealed Secrets (see doc/architecture/12-secrets-management.md) — this
# file only covers the Docker Compose / scripts/dev-up.sh path, which
# has no equivalent controller-backed secret store.

POSTGRES_PASSWORD=changeme-postgres-dev
RABBITMQ_PASSWORD=changeme-rabbitmq-dev
KEYCLOAK_ADMIN_PASSWORD=changeme-keycloak-admin-dev
