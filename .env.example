# Copy to .env and fill in real values for local development.
# .env is gitignored — never commit real credentials. docker-compose.yml
# and scripts/dev-up.sh both fall back to obvious, clearly-fake
# "changeme-*" defaults if this file doesn't exist, so a first-time
# clone still boots — those defaults are not meant to be used anywhere
# beyond a quick local smoke test.
#
# The equivalent K8s-side credentials live in k8s/base/secrets.yaml as
# Sealed Secrets (see doc/architecture/12-secrets-management.md) — this
# file only covers the Docker Compose / scripts/dev-up.sh path, which
# has no equivalent controller-backed secret store.

POSTGRES_PASSWORD=changeme-postgres-dev
RABBITMQ_PASSWORD=changeme-rabbitmq-dev
KEYCLOAK_ADMIN_PASSWORD=changeme-keycloak-admin-dev

# Different from the three above: docker-compose.yml's own default for
# this one is the REAL value already imported into the currently-running
# Keycloak instance, not a fake placeholder — keycloak/ecom-realm.json is
# now generated from ecom-realm.json.template (see
# scripts/render-realm-config.sh), so changing this value here and
# re-rendering keeps everything consistent automatically. Only a concern
# if you change it AFTER Keycloak has already imported the old value —
# Keycloak doesn't re-import on every restart, so you'd also need to
# wipe its data volume / force a fresh import for the two to match again.
KEYCLOAK_GATEWAY_CLIENT_SECRET=gateway-dev-secret-CHANGE-IN-REAL-DEPLOYMENT

# Phase 8: Google as a Keycloak identity provider (broker) — see
# doc/architecture/07-migration-planning.md. No fake default: Keycloak
# rejects an identity provider with an empty clientId/clientSecret
# rather than silently accepting one, so leaving these unset just means
# Google login isn't offered yet, not a broken realm import. Get real
# values from https://console.cloud.google.com — OAuth client, redirect
# URI http://localhost:8090/realms/ecom/broker/google/endpoint.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
